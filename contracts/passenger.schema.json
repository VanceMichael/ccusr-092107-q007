{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脱敏旅客",
  "type": "object",
  "required": ["pax_ref", "masked_name", "seat", "needs", "allergens"],
  "properties": {
    "pax_ref": { "type": "string", "pattern": "^pax-[a-z0-9]+$" },
    "masked_name": { "type": "string", "minLength": 1, "pattern": "\\*" },
    "seat": { "type": "string", "pattern": "^[0-9]+[A-Z]$" },
    "needs": {
      "type": "array",
      "items": { "type": "string", "enum": ["child", "low_sugar"] }
    },
    "allergens": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
