{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "供应商契约",
  "type": "object",
  "required": ["supplier_id", "airports", "supports_substitution", "batches"],
  "properties": {
    "supplier_id": { "type": "string", "minLength": 1 },
    "airports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "supports_substitution": { "type": "boolean" },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["batch_id", "meal_type", "quantity"],
        "properties": {
          "batch_id": { "type": "string", "minLength": 1 },
          "meal_type": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 0 },
          "contains": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
