{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "供应商",
  "type": "object",
  "required": ["supplier_id", "name", "airports", "capabilities"],
  "properties": {
    "supplier_id": { "type": "string", "pattern": "^sup-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "airports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["standard", "child", "low_sugar", "premium"] }
    }
  },
  "additionalProperties": false
}
